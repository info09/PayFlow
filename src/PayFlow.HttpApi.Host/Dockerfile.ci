# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/PayFlow.HttpApi.Host/PayFlow.HttpApi.Host.csproj
RUN dotnet publish src/PayFlow.HttpApi.Host/PayFlow.HttpApi.Host.csproj -c Release -o /app

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app .
EXPOSE 80
ENTRYPOINT ["dotnet", "PayFlow.HttpApi.Host.dll"]
